# Postgres. Railway injects DATABASE_URL automatically when you attach a Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saey

# Public origin of the app. Used to build QR codes and WhatsApp deep links,
# so it MUST be the real public URL or every printed QR code points nowhere.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first run by `pnpm db:seed`; a no-op once an admin exists.
ADMIN_EMAIL=admin@saey.sa
ADMIN_PASSWORD=change-this-immediately

# Where uploaded images live. On Railway, mount a volume and point this at it.
UPLOAD_DIR=./.uploads

# Rotated daily and mixed into the visitor hash so analytics stay unlinkable
# across days. Any random string.
ANALYTICS_SALT=replace-me-too
